@inreference{wiki-repeurandau,
  title = {레프 란다우 Lev Davidovich Landau #물리학자},
  author = {{레프 란다우}},
  date = {2024-05-31T12:25:26Z},
  url = {https://ko.wikipedia.org/w/index.php?title=%EB%A0%88%ED%94%84_%EB%9E%80%EB%8B%A4%EC%9A%B0&oldid=37267340},
  urldate = {2024-12-06},
  langid = {ko},
  abstract = {레프 다비도비치 란다우(러시아어: Лев Дави́дович Ланда́у, [lʲɛv dɐ'vidəvʲit͡ɕ lɐn'daʊ]; 1908년 1월 22일 - 1968년 4월 1일)는 소련 물리학자이다. 이론물리학의 다양한 분야에 걸쳐서 근본적인 공헌을 했다.
그의 업적은 양자역학에서 밀도 행렬 방법의 독립적인 공동 발견(존 폰 노이만과 함께), 반자성의 양자역학 이론, 초유체 이론, 이차 상전이, 긴즈부르크-란다우 이론, 페르미 액체 이론, 플라즈마 물리학의 란다우 감쇠 설명, 양자 전기역학의 란다우 극, 중성미자의 이성분 이론, S행렬 특이점에 대한 란다우 방정식 등을 포함한다. 그는 2.17K(-270.98 °C) 미만의 온도에서 액체 헬륨 II의 특성을 설명하는 초유체의 수학적 이론을 개발한 공로로 1962년 노벨 물리학상을 받았다.},
  keywords = {/unread},
  annotation = {Page Version ID: 37267340},
  datemodified = {2025-04-17T08:59:47Z},
  dateadded = {2024-12-06T01:56:29Z}
}

@inreference{wiki-alregseinabalniyijugeum,
  title = {알렉세이 나발니의 죽음},
  date = {2024-11-21T13:14:29Z},
  url = {https://ko.wikipedia.org/w/index.php?title=%EC%95%8C%EB%A0%89%EC%84%B8%EC%9D%B4_%EB%82%98%EB%B0%9C%EB%8B%88%EC%9D%98_%EC%A3%BD%EC%9D%8C&oldid=38199568},
  urldate = {2025-04-11},
  langid = {en},
  abstract = {2024년 2월 16일, 러시아 연방 교정청은 러시아 야당 지도자인 알렉세이 나발니가 야말로네네츠 자치구의 하르프에 위치한 하르프 IK-3 교도소에서 19년 징역형을 복역하던 중 사망했다고 발표했다. 나발니의 대변인인 키라 야르미시는 다음날 나발니의 시신을 확인했으며, . 나발니의 사인은 현재 정확히 밝혀지지 않았으며, 사망 당시 나이는 47세였다.
그의 죽음으로 인해 러시아를 포함해 여러 나라에서 수많은 시위가 일어났다. 여러 나라의 정치인들은 러시아 당국이 그의 죽음에 책임이 있다고 주장했다.},
  annotation = {Page Version ID: 38199568},
  datemodified = {2025-04-17T08:59:47Z},
