  urldate = {2024-12-04},
  langid = {ko},
  abstract = {르장드르 변환(Legendre變換, 영어: Legendre transformation)은 볼록함수를 다른 볼록함수로 변환하는 연산이다. 대략 한 좌표에 대하여 자연스러운 함수를, 이에 대응하는 운동량 좌표에 대하여 자연스러운 함수로 바꾸는 것으로 생각할 수 있다. 르장드르 변환은 스스로의 역이다. 즉, 어떤 함수에 르장드르 변환을 두 번 가하면 다시 원래 함수를 얻는다.},
  keywords = {/unread},
  annotation = {Page Version ID: 34293718},
