@inreference{wiki-003system,
  title = {003 System 시스템},
  date = {2024-05-18T03:50:01Z},
  url = {https://en.wikipedia.org/w/index.php?title=System&oldid=1224394697},
  urldate = {2024-05-18},
  langid = {en},
  abstract = {A system is a group of interacting or interrelated elements that act according to a set of rules to form a unified whole. A system, surrounded and influenced by its environment, is described by its boundaries, structure and purpose and is expressed in its functioning. Systems are the subjects of study of systems theory and other systems sciences.
Systems have several common properties and characteristics, including structure, function(s), behavior and interconnectivity.},
