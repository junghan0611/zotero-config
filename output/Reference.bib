@inreference{wiki-seukeuraecipeurogeuraemingeoneo,
  title = {스크래치 (프로그래밍 언어) Scratch},
  date = {2024-10-03T13:04:46Z},
  url = {https://ko.wikipedia.org/w/index.php?title=%EC%8A%A4%ED%81%AC%EB%9E%98%EC%B9%98_(%ED%94%84%EB%A1%9C%EA%B7%B8%EB%9E%98%EB%B0%8D_%EC%96%B8%EC%96%B4)&oldid=37942390},
  urldate = {2024-12-06},
  langid = {ko},
  abstract = {스크래치(Scratch)는 MIT 미디어 랩에서 8세~16세의 아이들을 대상으로 만든 교육용, 블록형 프로그래밍 언어이다. 이 사이트에서 활동하는 사람들인 '스크래쳐'(영어: Scratcher)들은 블록을 조립하는 방식으로 프로젝트를 만든다. 만들어진 프로젝트는 스크래치 웹사이트에서 누구나 실행하거나 하트나 별, 댓글을 달고 리믹스할 수 있다. 필요하다면 HTML5나 안드로이드 앱, EXE 등의 형식으로 내보낼 수도 있다.
2024년 1월 기준, 공유된 프로젝트는 15,929,322개, 등록된 계정은 100,411,828개, 프로젝트에 달린 댓글은 총 722,213,385개로 집계되었다. 또한, 스크래치 웹사이트는 지난 한 달 동안 711,425,440번의 접속이 있었다.
스크래치 체험용의 하위 버전인 1.4 버전은 오픈 소스라서 누구든지 스크래치 모딩(스크래치 모드를 만드는 행위)을 할 수 있다.},
  keywords = {/unread},
  annotation = {Page Version ID: 37942390},
  datemodified = {2024-12-06T03:16:19Z},
  dateadded = {2024-12-06T03:15:47Z}
}

