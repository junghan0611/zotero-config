  urldate = {2025-04-19},
  langid = {en},
  abstract = {박식가(博識家, 그리스어: πολυμαθής, polymathēs, "많은 배움을 가짐") 또는 만능인(라틴어: homo universalis 호모 우니베르살리스[*], 영어: universal man), 르네상스적 인간(Renaissance man)은 뛰어난 재능을 지닌 사람으로, 여러 분야에 걸쳐 폭넓게 전문적 지식을 갖고 있다. 쉽게 말하면, 매우 많이 아는 사람을 뜻한다. 고대 과학자의 거의 대부분은 오늘날 기준으로 보면 박식가이었다.},
