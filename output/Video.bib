@video{SocialNetwork10,
  title = {The Social Network},
  date = {2010},
  url = {https://www.youtube.com/watch?v=SKGYXwnA6L8},
  abstract = {데이빗 핀처 감독은 '소셜 네트워크'를 통해 새로운 형태의 문화적 반란에 대한 충격적인 이야기를 전달한다. 한 괴짜 천재가 한 세대의 인간 소통 방식에 획기적 혁명을 일으켰고 이 혁명은 어쩌면 영원히 계속될지도 모른다. 이 영화는 감정의 여과 없이 기발한 유머 감각으로 페이스북의 등장 그리고 이 엄청난 성공을 거둔 웹사이트에 대한 소유권을 둘러싼 법정 다툼을 그려낸다. 통찰력 있는 작가 아론 소킨 각본. 제시 아이젠버그, 앤드류 가필드, 저스틴 팀버레이크 주연. 사회조직망을 새롭게 짠 이 혁명이 오히려 장본인들의 우정을 파괴하는 아이러니를 보여주는 '소셜 네트워크'. (원제 - The Social Network) 2010 Columbia Pictures Industries, Inc. and Beverly Blvd LLC. All Rights Reserved.},
